{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "captcha",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  // Custom Domains: Cloudflare owns these DNS records and points them at this
  // Worker. No origin server is referenced any more.
  "routes": [
    { "pattern": "captcha.stead.africa", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    // Non-secret config. Secrets are set with `wrangler secret put` — see README.
    "ALLOWED_ORIGINS": "https://donaldson.africa,https://www.donaldson.africa,https://stead.africa,https://www.stead.africa"
  }
}
